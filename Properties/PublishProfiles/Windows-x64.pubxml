<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildProjectDirectory)\App\</PublishDir>
    <PublishUrl>$(MSBuildProjectDirectory)\App\</PublishUrl>
  </PropertyGroup>
  <!-- The package's fallback DLL has a newer timestamp than its Windows DLL.
       PreserveNewest can retain that fallback when publishing into an old App/. -->
  <Target Name="AlwaysPublishSerialPortRuntime" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'System.IO.Ports.dll'">
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
